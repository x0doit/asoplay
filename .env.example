#
# Скопируй в .env и заполни. Файл .env в git НЕ попадает (см. .gitignore).

# ==== VPN (xray proxy) ====
# 0: временно отключить VPN, сохранив параметры сервера.
AV_VPN_ENABLED=1
# VLESS + Reality: ссылка vless://… с VPN-сервера (её же можно импортировать в Happ).
# Если ссылка задана, SS_* ниже не используются.
# AV_VPN_URL=vless://uuid@your.server.ip:443?type=tcp&security=reality&flow=xtls-rprx-vision&sni=www.example.com&fp=chrome&pbk=public-key&sid=short-id
# Shadowsocks — для старых серверов без VLESS.
# SS_ADDRESS=your.server.ip.or.host
# SS_PORT=53224
# SS_METHOD=chacha20-ietf-poly1305
# SS_PASSWORD=your-shadowsocks-password

# ==== FastAPI server ====
# Куда биндиться — по умолчанию 127.0.0.1:8787
# AV_BIND_HOST=0.0.0.0
# AV_BIND_PORT=8787

# Embedded Jikan 5 (PHP >= 8.4.4). OSPanel PHP-8.4 is detected on Windows;
# on Linux use php from PATH or set its absolute path here.
# AV_JIKAN_PHP=C:/OSPanel/modules/PHP-8.4/php.exe

# Публичный origin сайта (нужен для canonical-URL, sitemap, robots).
# AV_SITE_URL=https://asoplay.example.com

# Название проекта в OpenGraph и JSON-LD.
# AV_SITE_NAME=AsoPlay

# CORS: список разрешённых origin'ов через запятую, либо "*" для wildcard.
# По умолчанию открыты локальные dev-origin'ы (127.0.0.1:5500/3000/8000/8787).
# AV_ALLOWED_ORIGINS=https://asoplay.example.com

# ==== AnimeSocial DB (читается из core/config/db.php по умолчанию) ====
# AV_DB_HOST=MySQL-8.0
# AV_DB_USER=root
# AV_DB_PASS=
# AV_DB_NAME=AnimeSocial
# AV_DB_PORT=3306
# AV_DB_PREFIX=Just

# Оверрайды для users-таблицы, если auto-detect выбирает не то.
# AV_USER_TABLE=Just_users
# AV_USER_ID_COL=id
# AV_USER_LOGIN_COL=login
# AV_USER_EMAIL_COL=email
# AV_USER_HASH_COL=password
# AV_USER_SALT_COL=salt
# AV_USER_NAME_COL=name
# AV_USER_STATUS_COL=status
# AV_USER_AVATAR_COL=avatar

# Какой верификатор пароля использовать.
# auto (default) — выбирается по форме хеша (bcrypt / sha256 / sha1 / md5+salt / dle).
# Иначе можно вручную: bcrypt | sha256 | sha1 | md5 | md5_salt | dle | plain | argon2
# AV_AUTH_VERIFIER=auto

# ==== Сессии и куки ====
# Время жизни login-сессии в днях. Дефолт 30.
# AV_SESSION_TTL_DAYS=30
# 1 — требовать HTTPS для login-cookie. Для прод — 1.
# AV_COOKIE_SECURE=0
# lax | strict | none. "none" требует Secure=1.
# AV_COOKIE_SAMESITE=lax

# ==== AnimeSocial (партнёр) ====
# Все ссылки на соцсеть собираются из core/config/animesocial.json. Переопределить
# можно только хост — пути (/login, /register, /uploads/accounts/...) зашиты
# в animesocial.json. Для локального OSPanel подставь https://animesocial.local
# AV_ANIMESOCIAL_SITE_URL=https://animesocial.online

# Legacy: прямо задать URL регистрации целиком (на случай, если у соцсети
# нестандартный маршрут). Если выставлено — перекрывает animesocial.json.
# AV_REGISTER_URL=https://animesocial.online/register

# ==== Вход через Anime Social (API v2, core/functions/social_login.py) ====
# 1 — показать кнопку «Войти через Anime Social». Нужны ключи клиента и ключ шифрования ниже,
# пакет cryptography и адрес возврата {сайт}/auth/as/callback у клиента AsoPlay в движке.
# AV_AS_LOGIN=0
# Ключи клиента AsoPlay: «Панель → Система → Сайты-клиенты» соцсети (/cpanel/clients).
# Секрет показывается один раз; держать только здесь, не в репозитории и не в JavaScript.
# AV_AS_CLIENT_ID=cl_…
# AV_AS_CLIENT_SECRET=cs_…
# Ключ шифрования токенов соцсети в базе: 32 байта в base64. Сгенерировать:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Смена ключа обрывает связь с сессиями соцсети: пользователям нужно войти заново.
# AV_TOKEN_KEY=
# Адрес API, если он не {AV_ANIMESOCIAL_SITE_URL}/api/v2.
# AV_AS_API_URL=https://dev.animesocial.online/api/v2
# Каким сертификатам доверять в запросах к соцсети: путь к файлу CA или system — хранилище системы
# (локальный движок в OSPanel с самоподписанным сертификатом). Пусто — набор certifi.
# AV_AS_CA=system
# Адрес возврата, если он не {схема}://{хост}/auth/as/callback текущего запроса.
# AV_AS_REDIRECT_URI=https://play.animesocial.online/auth/as/callback
# Ещё адреса сайта соцсети (через запятую), которым /auth/as/whoami отвечает с cookie (CORS);
# сайт из адреса API разрешён всегда.
# AV_AS_ORIGINS=https://animesocial.online

# ==== Списки: правило 30 дней (core/functions/lists_sweep.py) ====
# Раз в сутки auto-«Смотрю» без просмотра этого тайтла 30 дней уходит в «Брошено». Время прохода — UTC «ЧЧ:ММ»;
# не «ЧЧ:ММ» — ошибка в журнал и 04:00. off — не запускать по расписанию. После простоя сервера пропущенный проход
# идёт сразу при старте. Нужна миграция core/migrations/2026-10-31_task_runs.sql.
# AV_LISTS_SWEEP_AT=04:00

# ==== Раздел «AsoPlay» в /cpanel Anime Social (core/admin/router.py) ====
# Общий секрет подписи запросов панели: тот же, что в настройках раздела на стороне соцсети.
# Панель ходит на http://127.0.0.1:8787/api/admin/… с этой же машины; пусто — API выключен (503 not_configured).
# AV_ADMIN_SECRET=

# ==== Legacy / xray ====
# AV_VPN_CONFIG=/etc/asoplay/vpn.json
