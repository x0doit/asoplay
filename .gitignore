.env
.env.local

# Legacy файл с полным xray-конфигом (если кто-то вернётся к нему).
vpn.txt
vpn.json

# Рабочие файлы бэкенда — HTTP-кеш, списки adblock, конфиг и журнал xray; пересоздаются сами
core/config/cache/
# Так они лежали в корне до шага 3 рефакторинга (старые журналы xray ещё могут там быть)
.cache/
.xray-runtime.json
.xray*.log
deploy/

# Python
__pycache__/
*.pyc

# Installed PHP dependencies; reproducible from composer.lock, included in deploy.
core/classes/jikan/php/vendor/

